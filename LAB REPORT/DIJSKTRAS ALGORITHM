#include <stdio.h>

#define MAX 10
#define INF 999

int main()
{
    int cost[MAX][MAX], dist[MAX], visited[MAX];
    int n, i, j, source, count, mindist, nextnode;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter cost matrix:\n");

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            scanf("%d", &cost[i][j]);

            if (cost[i][j] == 0 && i != j)
                cost[i][j] = INF;
        }
    }

    printf("Enter source vertex: ");
    scanf("%d", &source);

   
    for (i = 0; i < n; i++)
    {
        dist[i] = cost[source][i];
        visited[i] = 0;
    }

    dist[source] = 0;
    visited[source] = 1;
    count = 1;

    while (count < n - 1)
    {
        mindist = INF;

        for (i = 0; i < n; i++)
        {
            if (dist[i] < mindist && !visited[i])
            {
                mindist = dist[i];
                nextnode = i;
            }
        }

        visited[nextnode] = 1;

       
        for (i = 0; i < n; i++)
        {
            if (!visited[i] &&
                mindist + cost[nextnode][i] < dist[i])
            {
                dist[i] = mindist + cost[nextnode][i];
            }
        }

        count++;
    }

    printf("\nShortest Paths from Vertex %d:\n", source);

    for (i = 0; i < n; i++)
    {
        if (i != source)
        {
            printf("%d -> %d = %d\n", source, i, dist[i]);
        }
    }

    return 0;
}
